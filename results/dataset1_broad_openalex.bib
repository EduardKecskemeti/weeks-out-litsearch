@article{kalpathycramer2016plus,
  title = {{Plus Disease in Retinopathy of Prematurity}},
  author = {Jayashree Kalpathy–Cramer and J. Peter Campbell and Deniz Erdogmus B and Peng Tian and Dharanish Kedarisetti and Chace Moleta and James D. H. Reynolds and Kelly A. Hutcheson and Michael J. Shapiro and Michael X. Repka and Philip J. Ferrone and Kimberly A. Drenser and Jason Horowitz and Kemal Sönmez and Ryan Swan and Susan R. Ostmo and Karyn E. Jonas and R.V. Paul Chan and Michael F. Chiang and Michael F. Chiang and Michael F. Chiang and Michael F. Chiang and Susan Ostmo and Kemal Sönmez and J. Peter Campbell and R V Paul Chan and Karyn Jonas and Jason Horowitz and Osode Coki and Cheryl-Ann Eccles and Leora Sarna and Audina Berrocal and Catherin I. Negron and Kimberly Denser and Kristi Cumming and Tammy Osentoski and Tammy Check and Mary Zajechowski and Thomas Lee and Evan Kruger and Kathryn McGovern and Charles Simmons and R.V. Murthy and Sharon Galvis and Jerome I. Rotter and Yii‐Der Ida Chen and Xiaohui Li and Kent Taylor and Kaye Roll and Jayashree Kalpathy-Cramer and Deniz Erdogmus B and María Ana Martinez-Castellanos and Samantha M. Salinas-Longoria and Rafael Romero and Andrea Arriola and Francisco Olguin-Manríquez and Miroslava Meraz-Gutierrez and Carlos M. Dulanto-Reinoso and Cristina Montero-Mendoza},
