@article{iturriamedina2016early,
  title = {{Early role of vascular dysregulation on late-onset Alzheimer’s disease based on multifactorial data-driven analysis}},
  author = {Yasser Iturria‐Medina and Roberto Carlos Sotero and P.-J. Toussaint and José María Mateos-Pérez and Alan Charles Evans and The Alzheimer’s Disease Neuroimaging Initiative and Michael Walter Weiner and Paul S. S. Aisen and Ronald Carl Petersen and Clifford R. Jack and William J. Jagust and John Q. Trojanowki and Arthur W. Toga and Laurel A. Beckett and Robert C. Green and Andrew J. Saykin and John C. Morris and Leslie M. J. Shaw and Zaven S. Khachaturian and Greg Sorensen and Lew Kuller and Marc Raichle and Steven M. Paul and Peter Davies and Howard M. Fillit and Franz F. Hefti and Davie Holtzman and Marsel M. Mesulam and William Z. Potter and Peter Jeffrey Snyder and Adam Schwartz and Tom Montine and Ronald G. Thomas and Michael Donohue and Sarah Walter and Devon Gessert and Tamie Sather and Gus Jiminez and Danielle Jenine Harvey and Matt A. Bernstein and Nick C. Fox and Paul M. Thompson and Norbert W. Schuff and Bret Borowski and Jeff L. Gunter and Matthew L. Senjem and Prashanthi Vemuri and David Thomas Jones and Kejal Kantarci and Chad Ward and Robert A. Koeppe and Norm Foster and Eric M. Reiman and Kewei Chen and Chester A. Mathis and Susan M. Landau and Nigel J. Cairns and Erin Householder and Lisa Taylor‐Reinwald and Virginia Lee and Magdalena Korecka and Michal Figurski and Karen L. Crawford and Scott Neu and Tatiana Foroud and Steven G. Potkin and Li Shen and Kelley M. Faber and Sungeun Kim and Kwangsik T. Nho and Leon J. Thal and Neil S. Buckholtz and Marylyn Albert and Richard A. Frank and John Hsiao and Jeffrey Alan Kaye and Joseph F. Quinn and Betty Lind and Raina Carter and Sara Dolen and Lon S. Schneider and Sonia Pawluczyk and Mauricio Beccera and Liberty Teodoro and Bryan M. Spann and James B. Brewer and Helen Vanderswag and Adam Fleisher and Judith L. Heidebrink and Joanne L. Lord and Sara S. Mason and Colleen S. Albers and David S. Knopman and Kris Johnson and Rachelle Smith Doody and Javier Villanueva‐Meyer and Munir H. Chowdhury and Susan D. Rountree and Mimi Dang and Yaakov Stern},
  year = {2016},
  journal = {Nature Communications},
  publisher = {Nature Portfolio},
  volume = {7},
  number = {1},
  pages = {11934},
  doi = {10.1038/ncomms11934},
  url = {https://openalex.org/W2474981734},
  note = {OpenAlex W2474981734; blocks b3v4},
  abstract = {Multifactorial mechanisms underlying late-onset Alzheimer's disease (LOAD) are poorly characterized from an integrative perspective. Here spatiotemporal alterations in brain amyloid-β deposition, metabolism, vascular, functional activity at rest, structural properties, cognitive integrity and peripheral proteins levels are characterized in relation to LOAD progression. We analyse over 7,700 brain images and tens of plasma and cerebrospinal fluid biomarkers from the Alzheimer's Disease Neuroimaging Initiative (ADNI). Through a multifactorial data-driven analysis, we obtain dynamic LOAD-abnormality indices for all biomarkers, and a tentative temporal ordering of disease progression. Imaging results suggest that intra-brain vascular dysregulation is an early pathological event during disease development. Cognitive decline is noticeable from initial LOAD stages, suggesting early memory deficit associated with the primary disease factors. High abnormality levels are also observed for specific proteins associated with the vascular system's integrity. Although still subjected to the sensitivity of the algorithms and biomarkers employed, our results might contribute to the development of preventive therapeutic interventions.}
}

