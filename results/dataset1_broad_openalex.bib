@article{masood2025health,
  title = {{Health Forte – Real-Time Healthcare Assistance Platform}},
  author = {Soman Masood and Syed Junaid and Syed Ahmed Uddin Akber and Dr. Md Zainlabuddin},
  year = {2025},
  journal = {International jounal of information technology and computer engineering.},
  volume = {13},
  number = {2s},
  pages = {34--40},
