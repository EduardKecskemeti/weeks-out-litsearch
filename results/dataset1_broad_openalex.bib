@article{darmayanti2025means,
  title = {{K-Means Clustering with Elbow Method for Stunting Risk Detection in Toddlers Using Anthropometric and Nutritional Data}},
  author = {Irma Darmayanti and Dhanar Intan Surya Saputra and Anugerah Bagus Wijaya and Andik Wijanarko and Dewi Fortuna and Aldrian Firmansyah Putranto},
  year = {2025},
  journal = {Journal of Information Systems and Informatics},
  publisher = {Universitas Bina Darma},
  volume = {7},
  number = {4},
  pages = {3735--3748},
  doi = {10.63158/journalisi.v7i4.1337},
  url = {https://openalex.org/W7118074765},
  note = {OpenAlex W7118074765; blocks b1+b1v3},
  abstract = {Stunting remains a critical public health challenge in Indonesia, primarily due to inadequate nutrition and recurrent infections in early childhood. This study aimed to identify patterns of stunting risk by integrating anthropometric and dietary data, specifically sugar consumption, using an unsupervised machine learning approach. A total of 20 toddlers aged 12-59 months from Purwokerto Selatan participated. Anthropometric data (age, weight, height) and dietary intake (sugar consumption, snack frequency) were collected via a caregiver questionnaire. K-Means clustering was applied, with the optimal number of clusters determined using the Elbow Method (K=2). Two clusters were identified: Cluster 0, with a lower risk of stunting, and Cluster 1, with a higher proportion of toddlers at risk. Cross-tabulation with stunting status validated this, showing that Cluster 1 contained more children with "Potential" stunting. Internal validation using the Silhouette score (0.252) and PCA visualization confirmed the clustering's robustness. This study demonstrates the potential of combining anthropometric and dietary data for stunting risk profiling, suggesting a complementary approach for growth monitoring programs and targeted interventions.}
}

@article{aminorroaya2025prospective,
  title = {{Prospective validation of an ensemble deep learning algorithm for detecting structural heart disease using real-world 12-lead electrocardiogram images}},
  author = {Arya Aminorroaya and A Ghaffari Jolfayi and Amirhossein Poopak and Mozhgan Parsaee and Maryam Shojaeifard and M Farrashi and Azin Alizadehasl and Kasra Mehdizadeh and Ehsan Bitaraf and Lovedeep Singh Dhingra and Parham Sadeghipour and Rohan Khera},
