  doi = {10.1007/s10278-025-01744-8},
  url = {https://openalex.org/W4416004366},
  note = {OpenAlex W4416004366; blocks b3v4},
  abstract = {Conventional brain tumour progression tracking methods inherently assume consistent image acquisition conditions between baseline and follow-up scans. In practice, however, MRI data often suffer from harmonisation issues due to variations in acquisition protocols, scanner settings, or patient positioning. To address this, we propose an image-based approach capable of identifying and localising changes between baseline and follow-up MRI scans without requiring independent registration or extensive pre-processing. Our registration-invariant method leverages the internal feature maps of a Siamese network composed of two segmentation models based on dilated convolutions, allowing it to learn long-context spatial features. These features are used to detect and localise changes directly from the input images, which are then enhanced using panchromatic sharpening to emphasise both high-level structural and pixel-level differences within the resulting change map. When tested on previously unseen, unregistered MRI scans, the method outperformed baseline models in identifying and localising resected tumour tissue ( $$varvecF\_varvec1 varvec= 0.64$$ and $$varvecIoU = 0.57$$ versus baseline $$varvecF\_varvec1 varvec= 0.11$$ and $$varvecIoU = 0.07$$ ). This performance remained robust under conditions of augmentation, noise, and misalignment ( $$varvecF\_varvec1 varvec= 0.55$$ and $$varvecIoU = 0.45$$ ), highlighting its resilience to real-world imaging variability. Overall, the proposed approach demonstrates strong robustness to spatial misalignment and offers a promising solution for tracking tumour progression and regression in clinical environments where reliable registration cannot be guaranteed.}
}

@article{dong2020sensitive,
  title = {{Sensitive biomarkers to Alzheimer's disease progression in longitudinal MRI from deep learning}},
  author = {Mengjin Dong and Long Xie and Jiancong Wang and Sandhitsu R. Das and David A. Wolk and Paul A. Yushkevich},
  year = {2020},
  journal = {Alzheimer s \& Dementia},
  publisher = {Wiley},
  volume = {16},
  number = {S5},
  doi = {10.1002/alz.047700},
  url = {https://openalex.org/W3112198961},
  note = {OpenAlex W3112198961; blocks b3v4},
  abstract = {Abstract Background In clinical trials of disease‐modifying treatments of Alzheimer’s disease (AD), the measure of hippocampus volume change from longitudinal MRI is a well‐studied biomarker of disease progression. However, even the most sensitive longitudinal MRI measures can be confounded by the presence of motion and susceptibility artifacts. We hypothesize that deep learning can be used to differentiate MRI changes due to biological factors (tissue loss) from changes due to artifact and other non‐biological factors, leading to novel biomarkers that are more sensitive to longitudinal change that can accurately evaluate disease progression. Method 357 subjects (142 training, 215 test) with 3‐8 longitudinal T1‐weighted MRI scans (0.5 to 5.5 years) were selected from ADNI2/GO (Table 1), including cognitively normal (CN), amyloid negative (A‐) older adults, preclinical AD (A+ controls), and A+ patients with early and late mild cognitive impairment (eMCI, lMCI). For each subject, pairs of scans were rigidly registered and trimmed around the hippocampal region. A 3D convolutional neural network (CNN3D) (He et al., 2015) was trained to detect the correct temporal order of arbitrarily ordered input pairs from the same subject and for two pairs of same‐subject images as input, to detect which pair had a longer interscan interval (Figure 1). The successful detection of the temporal order of scans would suggest that the network can capture only time‐induced biological change and ignore non‐biological factors that are independent of time. The results were compared to ALOHA, a deformation‐based morphometry algorithm for quantifying hippocampal change (Das et al., 2012). Result CNN3D extracted the temporal order of MRI scans much more accurately than ALOHA (Table 2, 3) and the CNN3D‐derived longitudinal change measure was more sensitive than ALOHA in differentiating healthy aging (A‐ CN) and preclinical AD (A+ CN) (Figure 2). CNN3D can also detect change in a shorter period of time (Figure 3). Conclusion CNN3D inferred the temporal order of longitudinal MRI scans, suggesting its ability to pinpoint true biological changes that correlate with time better than registration‐based approaches. Deep‐learning‐based MRI change detection may emerge as a more powerful disease progression biomarker for disease‐modifying clinical trials in AD.}
}

