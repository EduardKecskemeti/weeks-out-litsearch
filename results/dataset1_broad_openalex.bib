@article{anon2025intelligent,
  title = {{Intelligent diagnostics of intervertebral hernia lumbar with telemedicine}},
  author = {Епифанов Антон Вячеславович and Denis Zheikov and Anton V. Ivaschenko and G.P. Gerasimov and Авсиевич Владимир Викторович and A. E. Ponomarev and Панарин Владимир Сергеевич and Alexandr Avsievich and А. В. Колсанов},
