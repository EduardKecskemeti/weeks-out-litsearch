@article{moscarelli2025assisted,
  title = {{Assisted artificial intelligence in medical writing: a primer for humans}},
  author = {Marco Moscarelli and Francesco Pollari and Ilaria Franzese and Fabio Barili and Luca Di Marco and Antonio Nenna and Antonio Salsano and Giuseppe Santarpino},
  year = {2025},
  journal = {European Journal of Cardio-Thoracic Surgery},
  publisher = {Oxford University Press},
  volume = {67},
  number = {6},
  doi = {10.1093/ejcts/ezaf167},
  url = {https://openalex.org/W4411801984},
  note = {OpenAlex W4411801984; blocks b1+b1v3},
  abstract = {Assisted artificial intelligence (A-AI) has rapidly become a gold standard approach for conducting data analysis and medical writing [1]. From executing complex statistical tasks to extracting relevant information and supporting manuscript drafting, A-AI is increasingly embedded in the daily workflow of clinical and translational researchers [2]. However, the thin red line between being assisted by AI and becoming reliant on it, or even fully driven by it, is becoming harder to define. This ambiguity raises essential questions about authorship, accountability and the integrity of scientific output in the AI era. A growing number of early-career researchers are engaging with high-dimensional machine learning (ML) methodologies, often without comprehensive training in classical statistics or computational foundations. While the integration of such advanced tools reflects a welcome shift towards data-driven research, it also raises concerns regarding methodological rigor. In certain instances, traditional statistical frameworks are overlooked, and AI-generated outputs, particularly those derived from large language models, are interpreted without sufficient critical appraisal. To better understand this, 2 examples of A-AI analysis follow. To assess the magnitude of post-procedural thrombocytopaenia after transcatheter aortic valve implantation (TAVI) and its potential interplay with subclinical leaflet thrombosis (SLT) as detected by 1-month multidetector computed tomography (MDCT), I turned to my ‘Assisted AI master’. Within seconds, the AI generated a synthetic dataset comprising 100 patients and 120 prespecified variables, including demographic, procedural and post-implantation metrics, based on the assumption that SLT would occur in 18\% of the sample. To enhance realism, I requested a ‘real-world’ dataset with missing values and statistical outliers. My AI master not only accommodated these nuances but also proposed appropriate imputation strategies, including multiple imputation by chained equations. My assisted AI master returned the following dataset (synthetitic.csv) with the variables reported in Fig. 1 [3]. AI master was instructed to perform multiple imputation to address missing data. Variables’ name and description provided as synthetic data. Once the dataset was imputed, the AI executed an ML pipeline using the popular Extreme Gradient Boosting (XGBoost) algorithm to predict SLT [4]. Without any need for custom code or manual feature engineering, the model was trained and internally validated. To enhance interpretability, the AI automatically produced the R-code for a beeswarm plot of SHAP (SHapley Additive exPlanations) values, offering a visually compelling summary of the model’s top predictors and their direction of effect [5]. Within moments, a complete set of analytical outputs is provided and easily be mistaken for a results section ready for submission of for an abstract, for example (Fig. 2A). By interpreting the SHAP beeswarm plot, my A-AI master concluded that ‘Age’ was the most influential variable driving the model’s prediction of SLT. The entire process took only a few min. While the dataset is entirely synthetic, it remains a valuable resource for statistical training and method development. Both the dataset and the full R code are available for download in the public repository (https://github.com/mmlondon77/Biobook.). (A) SHAP plot showing which synthetic features have the biggest impact on the model’s predictions. (B) Forest plot of odds ratio by a multivariable logistic regression. BMI: body mass index; SHAP: SHapley Additive exPlanations. We aimed to explore whether colchicine is effective in preventing SLT at 1 month following TAVI. To do so, I turned to my AI master, and within min, a complete synthetic randomized clinical trial (RCT) was generated. The simulated RCT included 200 patients, randomized 1:1 to receive colchicine or placebo. Baseline and procedural variables were generated to reflect clinical realism, including: age, sex, body mass index (BMI), valve type (balloon-expandable or self-expanding), preoperative and postoperative platelet counts, Delta platelet drop (a marker of post-TAVI thrombocytopaenia), postoperative creatinine and bleeding complications. The primary end-point was the presence of SLT detected by multidetector CT (MDCT) at 1 month. The expected incidence of SLT was set at 30\% in the placebo group and 15\% in the colchicine group. A multivariable logistic regression confirmed the effect: patients in the placebo group had significantly higher odds of developing SLT compared to those receiving colchicine (adjusted OR 5.6, 95\% CI 2.45–12.8, P< 0.001), even after adjusting for age, sex, BMI, valve type and key procedural variables. What once required months of trial infrastructure and patient recruitment was now simulated, statistically sound, fully documented, and ready for analysis, in just a few min (Fig. 2B). The 2 examples reported above are intentionally simple and naïve, yet effectively demonstrate how rapidly AI can operate in the context of medical data analysis and scientific writing. Unsurprisingly, AI systems are now capable of generating far more complex synthetic datasets and corresponding manuscripts with increasing sophistication. There are some obvious risks with that. Opacity in authorship attribution: It is becoming increasingly difficult to discern the extent to which a manuscript has been generated by a human author versus an AI system. This lack of transparency challenges traditional notions of authorship, intellectual contribution, and accountability. Loss of analytical oversight: With the proliferation of AI-assisted data analysis tools, the control over analytical choices—such as model selection, assumptions testing and sensitivity analyses, is increasingly being delegated to algorithms. In many cases, researchers may not fully understand or critically evaluate the processes that led to the reported results. Bias amplification and misinterpretation: AI models, particularly those trained on large datasets without proper curation, may inadvertently propagate existing biases or generate misleading associations. Without expert oversight, spurious correlations may be reported as meaningful findings, distorting scientific conclusions [6]. Reproducibility and validation challenges: Many AI-generated analyses, especially those involving complex pipelines or proprietary algorithms, lack sufficient documentation to allow independent replication. This undermines a core principle of scientific research: reproducibility. Ethical and regulatory ambiguity: The accelerated integration of A-AI in research has outpaced the development of clear ethical guidelines and regulatory frameworks. Questions remain regarding data ownership, informed consent in AI-driven secondary analyses and appropriate disclosure of AI contributions in publications. Fabrication potential and misuse of synthetic data: AI tools now make it relatively easy to generate synthetic datasets that mimic real-world data [3]. While this can be useful for simulation or training purposes, the same tools can be misused to fabricate results that appear statistically sound but are entirely artificial. This creates new challenges for peer reviewers, editors and regulators tasked with validating the integrity of submitted research. Are we, as researchers, becoming obsolete? Can we still compete with the sheer ‘brute force’ of AI? By brute force, I mean the machine’s ability to analyse millions of potential patterns in moments, something no human can match. Consider chess. Stockfish (https://stockfishchess.org/), a leading chess engine built on alpha–beta pruning, is far more powerful than newer models like DeepSeek or even ChatGPT. It can evaluate billions of positions and calculate with ruthless precision. No human can match that computational depth. Yet humans bring something different intuition. The ability to feel the right move without calculation. To reach the same brilliant conclusion as Stockfish, not through search trees, but through instinct and insight. In medical research, we may no longer outperform AI in pattern recognition or speed. But the value of a well-formulated research question, of clinical intuition, of knowing what truly matters that remains uniquely human. If AI is the engine, then intuition must be the compass. This concept is rapidly becoming obsolete. The penetration of AI into the research process is no longer theoretical; it is already here, quietly embedded in literature searches, data cleaning, analysis pipelines and even the phrasing of sentences. Insisting on a rigid declaration of where ‘human input’ ends and ‘AI contribution’ begins may give the illusion of transparency, but in reality, the line is increasingly meaningless. The boundaries between human reasoning and machine assistance are dissolving. Is using AI to impute missing data different from using it to draft an introduction? Is grammar correction less artificial than code generation? Attempting to fence off human and machine contributions might once have made sense. Now, it risks becoming a distraction. The focus should shift: not who wrote the words or ran the code, but how responsibly, transparently and reproducibly the research was conducted. We are witnessing a proliferation of ‘mega journals’, not to mention the rise of predatory outlets, where the time from submission to online publication is often astonishingly short. As shown above, generating a synthetic paper or accelerating the analysis and writing process is now trivially easy with A-AI. While this can be useful for simulation or education, it also opens the door to a flood of potentially biased or low-quality publications, polluting the scientific literature. This raises a provocative question: should we deploy A-AI not just for authorship, but for peer review as well? Are we entering an era of machine versus machine, where algorithmic authors face off against algorithmic reviewers? At the end of the day, can a human truly compete with AI in spotting every flaw, inconsistency or statistical misstep? And more importantly, should we even try? Amid the flood of A-AI–generated science, patients may begin to question: Where does the truth lie? Who is behind the words they read in medical reports, trials, or treatment guidelines? And this, from a physician’s perspective, may be one of the greatest shadows of artificial intelligence, not the automation itself, but the erosion of trust. Trust that the knowledge is grounded in real experience. Trust that what is written was not merely generated, but truly understood. One of the most critical and underappreciated risks in the increasing use of A-AI is what aviation psychology describes as the out-of-the-loop performance problem (OOPP) [7]. Coined by Raja Parasuraman in 1997, this phenomenon occurs when human operators lose situational awareness and manual proficiency due to prolonged reliance on automation. When the system fails or abruptly relinquishes control, the human is cognitively and operationally unprepared to take over. In medicine, a parallel risk is emerging. As A-AI becomes more embedded in data analysis, diagnostics and manuscript generation, researchers and clinicians may gradually lose the ability—or confidence—to critically re-engage with raw data, statistical assumptions or narrative construction. Much like in aviation, where the safety of the flight ultimately depends on the pilot’s readiness to step in, the integrity and originality of scientific research may hinge on our ability to remain ‘in the loop’, despite the growing sophistication of the tools we use. Artificial intelligence did not descend from Mars. Its roots stretch back to early 20th-century thinkers who laid the intellectual groundwork for what we now call machine intelligence. It is uncertain whether Alan Turing ever said, ‘One day ladies will take their computers for walks in the park and tell each other, “My little computer said such a funny thing this morning.”’ Still, it is a charming image, and fitting, in spirit (Fig. 3). Turing (1912–1954) is widely regarded as the father of AI. In his seminal 1950 paper ‘Computing Machinery and Intelligence’, he asked a deceptively simple question: Can machines think? This led to the formulation of the Turing Test, a framework for evaluating machine intelligence, not by its internal workings, but by its behaviour [8]. Another example stems from Corrado Gini (1884–1965), an Italian economist, statistician and early socialist thinker. Best known for the Gini coefficient, a measure of inequality in income or wealth distribution, Gini developed mathematical tools to evaluate and correct disparities within societies [9]. Originally rooted in social justice and economic fairness, his work has since been reappropriated into modern computational contexts. In ML, the Gini importance (also known as mean decrease in impurity) is a fundamental metric used in decision tree algorithms like Random Forests (Fig. 4). It determines how much each feature contributes to reducing uncertainty when making splits in the tree, a far cry from its origins in wealth redistribution. English Heritage blue plaque marking the building where Alan Turing was born, located in Little Venice, London. Photo taken by M. Moscarelli, 2018. Random Forest for predictors using Gini Coefficient applied to synthetic data. Artificial intelligence is increasingly embedded in clinical research workflows, from data processing and modelling to manuscript drafting. While the human role remains essential—particularly in hypothesis formulation, clinical interpretation and ethical oversight—it is becoming more supervisory, curatorial or interpretive. In this context, the term AI-assisted medical writing may no longer be appropriate. A more accurate description reflects the reality of human-assisted machine research, where the computational workload is largely executed by algorithms under human direction. Acknowledging this inversion is essential to ensure transparency, methodological integrity and proper attribution in modern scientific communication. This study received no specific funding. Conflict of interest: The authors report no conflicts of interest. The GIROC is a task force of the Italian Society for Cardiac Surgery aimed to encourage, support and coordinate independent studies in the cardiac surgery community. We thank all the members of GIROC: L. Di Marco (Division of Cardiac Surgery, IRCCS Azienda Ospedaliero-Universitaria di Bologna, Italy), A. Nenna (Unit of Cardiac Surgery, Ospedale “Maggiore della Carità” di Novara, Novara, Italy), A. Salsano (Division of Cardiac Surgery, Ospedale Policlinico San Martino, Genoa, Italy DISC Department, University of Genoa, Genoa, Italy) and G. Santarpino (Department of Cardiac Surgery, Città di Lecce Hospital, GVM Care \& Research, Lecce, Italy). All code used for data generation, analysis and figure production—including the synthetic examples shown in this manuscript—is openly available in the corresponding author’s GitHub repository: https://github.com/mmlondon77/Biobook. Assisted artificial intelligence Multidetector computed tomography Machine learning The out-of-the-loop performance problem SHapley Additive exPlanations Subclinical leaflet thrombosis Transcatheter aortic valve implantation Extreme gradient boosting}
}

@article{bonilla2022artificial,
  title = {{Artificial Intelligence Applications in Digital Anthropometry 1}},
  author = {Diego A. Bonilla},
  year = {2022},
  journal = {OBM Integrative and Complementary Medicine},
  volume = {07},
  number = {04},
  pages = {1--4},
  doi = {10.21926/obm.icm.2204056},
  url = {https://openalex.org/W4312217401},
  note = {OpenAlex W4312217401; blocks b1+b1v3},
  abstract = {Anthropometric measurements are frequently used to assess changes in body composition in different populations. Despite being a cheap, in-field, and relatively valid technique, the COVID-19 pandemic has impulse research on digital anthropometry across the globe. Machine learning, as the convergence of artificial intelligence and data mining, has the potential to improve data collection and analysis in the applications of kinanthropometry. Far from replacing conventional methods, digital anthropometry is a powerful opportunity to increase accuracy, validity, practicality, and the use of self-monitoring procedures under professional supervision. However, further research and scientific literacy among practitioners are warranted.}
}

