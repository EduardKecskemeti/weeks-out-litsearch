@article{jahouh2025image,
  title = {{Image-Based Identification and Localisation of Changes in Intraoperative Brain Tumour Resection}},
  author = {Adil Jahouh and Andrei C. Jalba and Maxime Chamberland},
  year = {2025},
  journal = {Journal of Imaging Informatics in Medicine},
  publisher = {Springer Science+Business Media},
  volume = {39},
