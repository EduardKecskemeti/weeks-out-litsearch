@article{kim2025learning,
  title = {{Learning-based inference of longitudinal image changes: Applications in embryo development, wound healing, and aging brain}},
  author = {Heejong Kim and Batuhan K. Karaman and Qingyu Zhao and Alan Q. Wang and Mert Rory Sabuncu and Alzheimer’s Disease Neuroimaging Initiative and Michael Walter Weiner and Paul S. S. Aisen and Ronald Carl Petersen and Clifford R. Jack and William Jagust and Susan M. Landau and Monica Rivera-Mindt and Ozioma C. Okonkwo and Leslie M. J. Shaw and Edward B. Lee and Arthur W. Toga and Laurel A. Beckett and Danielle Harvey and Robert C. Green and Andrew J. Saykin and Kwangsik T. Nho and Richard J. Perrin and Duygu Tosun and Pallavi Sachdev and Robert C. Green and Erin Drake and Tom Montine and Cat Conti and Michael Walter Weiner and Rachel L. Nosheny and Diana Truran Sacrey and Juliet Fockler and Melanie Jayne Miller and Winnie Kwang and Chengshi Jin and Adam Diaz and Miriam Thiel Ashford and Derek Flenniken and Adrienne Kormos and Ronald Carl Petersen and Paul S. S. Aisen and Michael S. Rafii and Rema Raman and Gustavo Adolfo Jimenez‐Maggiora and Michael Donohue and Jennifer Salazar and Andrea Fidell and Virginia Boatwright and Justin Robison and Caileigh Zimmerman and Yuliana Cabrera and Sarah Walter and Taylor Clanton and Elizabeth Shaffer and Caitlin Webb and Lindsey Hergesheimer and Stephanie R. Smith and Sheila Ogwang and Olusegun Adegoke and Payam Mahboubi and Jeremy Pizzola and Cecily Jenkins and Laurel A. Beckett and Danielle Harvey and Michael Donohue and Naomi H. Saito and Adam Diaz and Kedir Adem Hussen and Ozioma C. Okonkwo and Monica Rivera-Mindt and Hannatu Amaza and Mai Seng Thao and Shaniya Parkins and Omobolanle Ayo and Matt Glittenberg and Isabella Hoang and Kaori Kubo Germano and Joe Strong and Trinity Weisensel and Fabiola Magana and Lisa Thomas and Vanessa Guzmán and Adeyinka O Ajayi and Joseph Di Benedetto and Sandra Talavera and Clifford R. Jack and Joel P. Felmlee and Nick C. Fox and Paul M. Thompson and Charles S DeCarli and Arvin Arani and Bret Borowski and Calvin D. Reyes and Caitie Hedberg and Chad Ward and Christopher G. Schwarz and Denise Reyes and Jeff L. Gunter and John Moore-Weiss},
  year = {2025},
  journal = {Proceedings of the National Academy of Sciences},
  publisher = {National Academy of Sciences},
  volume = {122},
  number = {8},
  pages = {e2411492122},
  doi = {10.1073/pnas.2411492122},
  url = {https://openalex.org/W4407762158},
  note = {OpenAlex W4407762158; blocks b3v4},
  abstract = {Longitudinal imaging data are routinely acquired for health studies and patient monitoring. A central goal in longitudinal studies is tracking relevant change over time. Traditional methods remove nuisance variation with custom pipelines to focus on significant changes. In this work, we present a machine learning–based method that automatically ignores irrelevant changes and extracts the time-varying signal of interest. Our method, called Learning-based Inference of Longitudinal imAge Changes (LILAC), performs a pairwise comparison of longitudinal images in order to make a temporal difference prediction. LILAC employs a convolutional Siamese architecture to extract feature pairs, followed by subtraction and a bias-free fully connected layer to learn meaningful temporal image differences. We first showcase LILAC’s ability to capture key longitudinal changes by simply training it to predict the temporal ordering of images. In our experiments, temporal ordering accuracy exceeded 0.98, and predicted time differences were strongly correlated with actual changes in relevant variables (Pearson Correlation Coefficient r = 0.911 with embryo phase change, and r = 0.875 with time interval in wound healing). Next, we trained LILAC to explicitly predict specific targets, such as the change in clinical scores in patients with mild cognitive impairment. LILAC models achieved over a 40\% reduction in root mean square error compared to baseline methods. Our empirical results demonstrate that LILAC effectively localizes and quantifies relevant individual-level changes in longitudinal imaging data, offering valuable insights for studying temporal mechanisms or guiding clinical decisions.}
}

