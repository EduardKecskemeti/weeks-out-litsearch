@article{lehner2021workflow,
  title = {{Workflow for Segmentation of Caenorhabditis elegans from Fluorescence Images for the Quantitation of Lipids}},
  author = {Theresa Lehner and Dietmar Pum and Judith Maria Rollinger and Benjamin Kirchweger},
  year = {2021},
  journal = {Applied Sciences},
  publisher = {Multidisciplinary Digital Publishing Institute},
  volume = {11},
  number = {23},
  pages = {11420},
  doi = {10.3390/app112311420},
  url = {https://openalex.org/W4200083110},
  note = {OpenAlex W4200083110; blocks b1+b1v3},
  abstract = {The small and transparent nematode Caenorhabditis elegans is increasingly employed for phenotypic in vivo chemical screens. The influence of compounds on worm body fat stores can be assayed with Nile red staining and imaging. Segmentation of C. elegans from fluorescence images is hereby a primary task. In this paper, we present an image-processing workflow that includes machine-learning-based segmentation of C. elegans directly from fluorescence images and quantifies their Nile red lipid-derived fluorescence. The segmentation is based on a J48 classifier using pixel entropies and is refined by size-thresholding. The accuracy of segmentation was >90\% in our external validation. Binarization with a global threshold set to the brightness of the vehicle control group worms of each experiment allows a robust and reproducible quantification of worm fluorescence. The workflow is available as a script written in the macro language of imageJ, allowing the user additional manual control of classification results and custom specification settings for binarization. Our approach can be easily adapted to the requirements of other fluorescence image-based experiments with C. elegans.}
}

@article{li2024embeddable,
  title = {{An Embeddable Implicit IUVD Representation for Part-Based 3D Human Surface Reconstruction}},
  author = {Baoxing Li and Yong Deng and Yehui Yang and Xu Zhao},
  year = {2024},
  journal = {IEEE Transactions on Image Processing},
  publisher = {Institute of Electrical and Electronics Engineers},
  volume = {33},
  pages = {4334--4347},
  doi = {10.1109/tip.2024.3430073},
  url = {https://openalex.org/W4401016637},
  note = {OpenAlex W4401016637; blocks b1+b1v3},
  abstract = {To reconstruct a 3D human surface from a single image, it is crucial to simultaneously consider human pose, shape, and clothing details. Recent approaches have combined parametric body models (such as SMPL), which capture body pose and shape priors, with neural implicit functions that flexibly learn clothing details. However, this combined representation introduces additional computation, e.g. signed distance calculation in 3D body feature extraction, leading to redundancy in the implicit query-and-infer process and failing to preserve the underlying body shape prior. To address these issues, we propose a novel IUVD-Feedback representation, consisting of an IUVD occupancy function and a feedback query algorithm. This representation replaces the time-consuming signed distance calculation with a simple linear transformation in the IUVD space, leveraging the SMPL UV maps. Additionally, it reduces redundant query points through a feedback mechanism, leading to more reasonable 3D body features and more effective query points, thereby preserving the parametric body prior. Moreover, the IUVD-Feedback representation can be embedded into any existing implicit human reconstruction pipeline without requiring modifications to the trained neural networks. Experiments on the THuman2.0 dataset demonstrate that the proposed IUVD-Feedback representation improves the robustness of results and achieves three times faster acceleration in the query-and-infer process. Furthermore, this representation holds potential for generative applications by leveraging its inherent semantic information from the parametric body model.}
}

@article{burns2024precision,
  title = {{Precision animal husbandry: using artificial intelligence for camera traps to optimize animal production and management decision support systems}},
  author = {Amira Burns and Hailey Wilmer and Ryan S. Miller and Patrick E. Clark and Joshua Bret Taylor},
  year = {2024},
  journal = {Animal Frontiers},
  publisher = {Oxford University Press},
  volume = {14},
  number = {6},
  pages = {68--71},
  doi = {10.1093/af/vfae026},
  url = {https://openalex.org/W4406077916},
  note = {OpenAlex W4406077916; blocks b1+b1v3},
  abstract = {• Artificial intelligence (AI) has the potential to save producers and researchers money and time in deploying camera trap arrays for animal monitoring. • Accessible tools for animal detection and classification, individual animal id, and behavior, movement estimation are available to a wide range of practitioners. • AI tools can support adaptive management strategies. • AI tools are currently adaptive to user input, allowing engaged users to influence development. The future implications of these technologies in assisting adaptive and precision management in complex agroecosystems will depend on continued collaboration among managers and scientists. Agroecosystems are often managed as multifunctional landscapes for food production, conservation, recreation, and social goals. Resource managers and livestock producers make crucial decisions dependent on spatiotemporal information of the presence or abundance of certain species, including predators, invasive species, or potential disease vectors, but this information is frequently lacking for complex ecosystems. Camera traps are a low-cost, non-invasive, and widespread approach to collecting animal monitoring data. The sheer volume of images generated by a camera trap array presents a resource challenge for converting these raw data into quantifiable, accessible decision aids, e.g., species distribution maps, or early warning systems to detect disease or invasive species. Artificial intelligence (AI) technologies can improve the capacity of scientists, managers, and ranchers to assess, monitor, and adapt management practices to these dynamic conditions and disparate objectives, increasing productivity and profitability while minimizing resource inputs. This paper explores the intersection of camera trap monitoring and AI-based image processing, known as computer vision, as an example application of AI to adaptive agroecological management. The chosen tools are accessible to a wide range of practitioners without necessitating computational expertise and have potential to expand to wider use. We propose a logic feedback model (Figure 1) that incorporates AI tools for camera traps to quantify and assist with decision making, using a scientific framework to inform contextual management strategies. Logic feedback model where computer vision tools for camera trap images form the core of adaptive management, research, and planning strategies. A good experimental design is essential to camera arrays regardless of size or project context, from meeting production objectives to answering research questions. A systematic approach engenders more comprehensive information-gathering to address motivating questions or information needs and allows one to answer additional questions that were not conceived at the initial planning stage. Design parameters vary depending on species of interest and planning goals; nascent computational tools such as R packages camtrapmonitoring (https://github.com/robitalec/camtrapmonitoring) and cameratrapgridR (https://github.com/CameraTrapDetectoR/cameratrapgridR/) can help create methodological camera trap deployment arrays according to user-specified criteria. While AI is not directly applied during planning, any insights gleaned from using AI on a camera array would inform future planning stages as part of iterative adaptive management or research strategies. Computer vision models are currently being deployed on-device by custom providers or in a cloud environment to reduce false triggers, classify animals by species, send notifications in real time, and even identify individual animals. The Conservation X Labs Sentinel camera (https://sentinel.conservationxlabs.com/) uses customized object detection models and adapted hardware to provide real-time notification capabilities in a variety of settings, including livestock monitoring, with full technological support. The NanoDetector (https://nanodetector.ai), developed by the University of Idaho with the Wildlife and Humans in Shared Landscapes Project (https://whisl.org) also deploys customized AI models on-device to detect and classify animals and notify users in real time using open-source software and standard commercial hardware. Recreational camera manufacturers including Bushnell, Moultrie, and Spypoint advertise species recognition for common hunting targets; we are unable to verify the methodology or accuracy of these offerings, but they indicate a growing interest in computer vision for camera trap images. These examples indicate a future widespread availability of real-time or on-device AI camera trap technologies. Due to the size and volume of image files generated and potential incompatibilities with remote processing and transfer, current practice usually necessitates processing camera trap data upon retrieval; many computer vision tools are specifically designed for this application. Select examples stand out for their accessibility, privacy, or application to animal production. Our tool CameraTrapDetectoR (Tabak et al., 2022; https://github.com/CameraTrapDetectoR) deploys object detection deep learning models at the taxonomic species, family, and class levels on multiple platforms to serve users with varying levels of technical experience. Models are trained on an agriculture-focused dataset by a USDA development team, with a mission of retaining data privacy while providing free, generalized, one-stop detection, and classification AI models. Pytorch Wildlife (https://github.com/microsoft/CameraTraps) is supported by millions of training images and is highly accurate at animal detection but necessitates subsequent computer vision tools to automate classification. Wildlife Insights (https://www.wildlifeinsights.org) has a comfortable user interface and species-level classification but requires users to share their data to a cloud source and charges a fee above an image threshold or team size. The automation of image processing via computer vision acts as a gateway to establishing larger camera trap arrays with more cameras that can be deployed over longer time periods. The ability to process more data across larger areas at faster speeds will lead to more comprehensive data and better-informed analyses and decisions. Computer vision tools are also innovating analysis of classified camera trap images. Two types of AI models have broad implications for both managers and researchers: individual animal id and pose estimation. AI-assisted estimates of density, group behavior, and presence/absence can already be used to track management outcomes and inform adaptive management in animal systems. We anticipate future development of more affordable, accessible, and accurate AI tools for individual animal identification to estimate population size and monitor ecological events such as wildlife-livestock interactions, foraging behavior, and the effect of environmental factors. Managers could more closely monitor individuals’ behavior, and researchers will be able to use these tools to replace mark-recapture methods and other expensive, intensive interventions to estimate populations and monitor the spread of invasive species. The concept has been proven in an open-source format by SealNet (https://github.com/zbirenbaum/SealFaceRecognition), a facial recognition software for harbor seals that can be run on an AWS-supported Graphical User Interface (GUI) and by BearID (https://github.com/bearid/bearid-dlib), an open-source workflow to recognize individual bears that can be reproduced on other datasets. Both projects operate on closed datasets where all individuals are known and previously identified; however, their success indicates progress towards open systems with updated methodologies where previously unknown individuals can be identified and labelled. AI-supported pose estimation and movement tracking tools are essential for quantifying animal behavior, e.g. early disease detection or quantifying desirable behaviors, and can be used to inform management decisions. The DeepLabCut (Mathis et al., 2018), LabGym (Hu et al., 2023), and SLEAP (Pereira et al., 2022) tools guide users to label a small number of training images, then fine-tune a custom deep-learning model to quantify and track behaviors across an entire dataset. Additional tools to track animal behavior include DeepEthogram (https://github.com/jbohnslav/deepethogram) and SimBA (https://github.com/sgoldenlab/simba). Species interactions are of particular interest in camera trap arrays, and SLEAP offers the unique capability to detect and track multiple species’ behaviors in the same frame. These tools can measure animal physiology or traits such as the standardization of Body Composition Score, quantify behaviors and features that optimize reproductive output, or detect and quantify interaction between individuals. Results from these tools can also feed back into image processing models to optimize their training data and improve performance; for example, the CameraTrapDetectoR project is using SLEAP and DeepLabCut to improve training data by annotating animal orientation, thus creating a more effective training sample with fewer images that is stratified across different poses and behaviors. AI-based tools are essential to expanding the information reach and processing capacity of large data for systems-based, trans-disciplinary learning that provide better decision frameworks for all stakeholders on a multi-use landscape. For example, a collaborative stakeholder group can combine resources to deploy a single robust, comprehensive camera array on a landscape that would enable all contributors to answer different questions, build trust and learning, improve efficiency and service-delivery outcomes, and close the gap among organizations with different missions using the same landscape. A collaborative approach would further reinforce ethical and responsible use of AI-based tools. The fast-paced, flexible nature of computer vision provides a current opportunity to become an engaged user in these open-source tools and directly influence development through participant feedback. These tools can support a system of precision animal production that bolsters existing collaborative, adaptive management practices and enhances our ability to respond to dynamic biological and social conditions. Amira Burns is a fellow with the USDA Agricultural Research Service (ARS), Range Sheep Production Efficiency Research Unit at the US Sheep Experiment Station, and the ARS SCINet Program and AI Center of Excellence. She holds a Masters in Applied Statistics from Colorado State University. She is the developer and maintainer of the CameraTrapDetectoR project. Her research focuses on developing user-friendly tools to advance animal, agricultural, environmental, and health science. Corresponding author:[email protected] Hailey Wilmer is a Research Rangeland Management Specialist at the USDA-ARS Range Sheep Production Efficiency Research Unit in Dubois, Idaho, USA. She completed MS and PhD in rangeland ecosystem science at Colorado State University. Prior to joining the US Sheep Experiment Station staff in 2021, Hailey worked at the USDA-ARS in Fort Collins and as a social scientist with the US Forest Service in Juneau. Her current research questions include: what are the long-term effects of grazing, climate, and other disturbances on high elevation rangeland plant communities? How can researchers and managers work together to conduct useful and useable science? How do ranchers and managers make sense of the complex systems they manage? Can mainstream science integrate local knowledge to support ranching livelihoods, biodiversity, and food production? Ryan S. Miller is a senior ecologist with United States Department of Agriculture Center for Epidemiology and Animal Health. He received a Doctor of Philosophy in Zoology from Colorado State University working with Dr. Colleen Webb and the Webb Lab, a Master of Science in Forestry and a Bachelor of Science in Forest Management. His research spans landscape and population ecology, with special interests in disease ecology and conservation biology, mechanisms that drive contact and transmission of pathogens at the wildlife-livestock interface, and how policy can be established to mitigate transmission. J. Bret Taylor is the research leader of the USDA ARS, Range Sheep Production Efficiency Research Unit at the US Sheep Experiment Station near Dubois, Idaho. He holds PhD and MS degrees (New Mexico State University) in animal science with emphases in ruminant nutrition, molecular biology, and toxicology and BS degrees (West Texas A\&M University) in chemistry and animal science. His research focuses on developing ecologically-oriented sheep genetic resources applicable toward grazing utility of sheep originating from extensive rangeland systems and discovery and application of unique antibiotic-replacement products. Patrick E. Clark is a Rangeland Scientist with the USDA Agricultural Research Service Northwest Watershed Research Center in Boise, Idaho. His research interests span disturbance ecology, range animal behavior, pastoralism, and remote sensing. This manuscript was invited for submission by the American Society of Animal Science (ASAS). The views expressed in this publication are those of the authors and do not necessarily reflect the views or policies of the ASAS, the journal, or the publisher. A.B.: Conceptualization; Writing—original draft; Writing—review and editing. H.W.: Conceptualization; Visualization; Writing—review and editing. R.S.M.: Conceptualization; Writing—review and editing. B.J.T.: Conceptualization; Writing—review and editing. P.E.C.: Conceptualization; Writing—review and editing Conflict of interest statement. None declared.}
}

@article{conde2024five,
  title = {{The five generations of facial recognition usage and the Australian privacy law}},
  author = {Jorge Conde and Dan Jerker B. Svantesson},
  year = {2024},
  journal = {International Data Privacy Law},
  publisher = {Oxford University Press},
  volume = {14},
  number = {3},
  pages = {247--258},
  doi = {10.1093/idpl/ipae007},
  url = {https://openalex.org/W4399923119},
  note = {OpenAlex W4399923119; blocks b1+b1v3},
  abstract = {Key Points This article describes the advances in face mining technologies and aligns these with Australian data privacy law, explaining the division of facial recognition usage into five generations. The article analyses the risks and gaps in data privacy laws, particularly within the Australian context, and offers recommendations for reform. Australian law regulates biometric data, including facial biometric data (FBD), as sensitive information. However, the legislation and regulatory focus are primarily on what may be termed the second-generation use of FBD; that is, for automated verification or identification. Australia is undergoing a reform of its data privacy law, which may impact the regulation of FBD. The reform proposals include redefining personal information to include inferred information and creating a non-exhaustive list of personal information types. The reform also suggests updating the categories of sensitive information and considering the regulation of biometric technologies. To address the challenges surrounding biometric data privacy, several solutions are proposed. These include legislation to cover all generations of facial recognition usage and future technologies. Further, a provision should be included to prevent tech companies from circumventing the law by obtaining user consent. Guidelines on data storage should be established, including a maximum retention period, encryption, and government audits for compliance. Non-compliance should result in penalties comparable to the European Union General Data Protection Regulation. Many things come into mind when people hear ‘facial recognition’, including but not limited to using a facial image to verify age when purchasing alcohol at self-checkouts, unlocking a mobile phone, using a security camera to flag possible shoplifters,1 tagging people on social media platforms,2 and passing through an airport’s e-passport gate. While these everyday activities highlight facial recognition biometrics applications, each one significantly differs in the approach and implications of using, storing, handling, and controlling data. To claim that facial biometric data (FBD) may be abused and constitutes a data privacy concern is merely a truism. Indeed, concerns about this matter were discussed already in the very first issue of this journal.3 Further, the fact that data privacy laws around the world generally apply to, and provide rules for, the processing of facial biometrics is well-established. However, it is equally well established that this regulation contains grey zones, and it is frequently observed that the current regulation of FBD is inadequate.4 This article contributes to the discourse on the regulation of FBD by proposing a novel classification of the different uses of facial biometric data; we divide it into five ‘generations of use’. Having provided an overview of facial biometrics and the first three generations of facial biometric data use, we discuss and analyse the fourth- and fifth-generation use of FBD in more detail. This is because we see the use of these later generations as insufficiently explored and particularly invasive. In doing so, we point to some of the key risks that such use poses to data privacy. We then seek to assess how well prepared the data privacy law is to address these risks, through the lens of Australia’s federal Privacy Act 1988 (Cth)—Australia’s main data privacy law. At the time of writing, Australia is in the process of reforming its Commonwealth data privacy law. This makes focusing on Australian law particularly timely and compelling. The ‘gap analysis’ is followed by a set of recommendations. The ultimate goal of this article is to spark, guide, and facilitate, law reform in relation to what we see as one of the greatest threats to data privacy the world currently is facing. The claim that the face is a mirror of the soul is more than a well-known cliché. The face has always revealed—with a reasonable degree of accuracy—matters such as age, gender, and ethnicity; that is, data that traditionally are classed as ‘personal’ under data privacy laws around the world. These types of data are ‘static’ in that they generally do not change quickly, and in the case of ethnicity not at all. Our faces may also reveal other types of data. For example, our facial expressions may say quite a lot about how we are feeling; if we are sad, happy, surprised, concerned, angry, irritated, and so on.5 These types of data are, for obvious reasons, highly ‘dynamic’. These dynamic data may especially reveal more than we as individuals may intend or wish to reveal. Apart from utilizing some form of face-covering, there is not much we as individuals can do to avoid our faces revealing these types of data. Furthermore, our sensitive FBD are costly and difficult to change. For instance, when an individual’s password or credit card information falls into the hands of third parties, the individual may quickly change them. However, suppose a third party can access an individual’s photo or video; in that case, the individual is unlikely to want to change their face making permanent and irreversible the personal data privacy breach. However, until relatively recently the data revealed by our faces was arguably of comparatively limited concern from a data privacy perspective. The use of such data was in most cases: (i) location-dependent and (ii) limited in time. Only persons around us at a given moment could collect the data that may be collected from our faces. In addition, any permanent collection via photography or video was then only small scale. This is all changing. The collection of FBD—driven by behavioural changes, technological developments, security concerns, and commercial incentives—is rapidly increasing. The pervasiveness of FBD collection for security purposes has gained a considerable degree of attention.6 In this article, we consider such collection undertaken for commercial purposes and discuss a recent high-profile matter from Australia. The explosion of social media, and the rate at which photos showing people’s faces are being posted online have created serious concerns. Social networking has become part of everyday life as over 5.11 billion individuals have access to smartphones for accessing the internet and social media sites.7 According to Karki,8 more than 1.4 trillion images exist online. Additionally, 3.2 billion photographs are uploaded daily, creating surplus personal photos online.9 Dutton and others10 reported human behaviours transforming from listening to music online to sharing and posting personal photos online. Daily Facebook picture uploads have reached 350 million, while Snapchat records as high as 700 million average daily photo uploads.11 Over 1 billion videos and 4.5 billion photos are shared on WhatsApp alone, every day.12 All this leads us to believe that the regulation of the use of FBD has never been more important. Yet, the current discourse is hindered by a lack of nuance. The use of FBD is largely treated as one single matter, when in fact it is far more nuanced than that. In addition, our current regulation fails to address the most recent developments in how FBDs are utilized. FBD use may conveniently be divided into five different generations. The purpose of this categorization is to aid in identifying gaps in the current regulation of FBD use. In answering the question, ‘Who am I?’, the first generation of face biometrics signifies the most ‘novel’ period of its evolution. Few biometric identifications existed during this time, largely owing to the limited scope of technological research in this area.13 The first generation of facial recognition technology (FRT), which dates back to the mid-20th Century (1963), aimed to provide a solid computational understanding of facial images that would be later used in subsequent integrations with other technologies.14 However, the complexity and diversity of face structure derailed development in this era as research took more time to understand how to encode and link different mathematically represented facial features.15 In this regard, the first generation of face biometrics can be best understood as an identification phase where machines attempt to encode faces, making it easier to link with other computational technologies. In the first automated facial recognition To the challenges and possible solutions to the of facial In one of how the of different people would be as of the of their solutions to the issue of included that to encode under FBD use, to as facial is the usage of face biometrics to the purpose of a face with an of is that in an on identifying faces has not recognition technology is currently at This all other such as and recognition in the of the was with facial recognition were only in making the second-generation FBD use about answering the question, say The of the facial biometric technologies set the for with more technologies. research were to research also on the first generation in and facial The of of the and in social media, also advances in this particularly with subsequent developments which people to images to the already FBD use that second-generation FBD second-generation FBD use significantly differs from the most However, to link the with a image in a are during the with from and as an to the The of and in second-generation FBD use also FBD For example, and a and facial biometric technologies to to the face second-generation FBD were it could not the and of the facial biometric the for facial biometric data use. The include unlocking and using or The facial biometric has been as or it using FBD to and link to data. the FBD use is about answering the question, information may be to, on a to at automated for accessing personal information about a from an on an image of that on three different relatively recent The first is face recognition The is which social networking the of faces to or FBD t