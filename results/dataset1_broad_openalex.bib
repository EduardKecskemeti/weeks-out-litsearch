@article{santos2025anabolic,
  title = {{Anabolic staders: benefits and harms in women who practice bodybuilders}},
  author = {Bianca Oliveira Santos and Suelene Candido de Souza and Gustavo Vinícius Bento Silva and Vanessa Neres Resende and Carlos Eduardo Pereira Silva and Rodrigo Oliveira Fonseca and Luzimar José Gonçalves and Halline Cardoso Jurema},
  year = {2025},
  journal = {OBSERVATÓRIO DE LA ECONOMÍA LATINOAMERICANA},
  publisher = {Servicios Academicos Intercontinentales},
  volume = {23},
  number = {10},
  pages = {e11740},
  doi = {10.55905/oelv23n10-039},
  url = {https://openalex.org/W4414904334},
  note = {OpenAlex W4414904334; blocks b2},
  abstract = {The use of anabolic-androgenic steroids (AAS) by female bodybuilders has grown, driven by aesthetic standards and the search for rapid hypertrophy results and reduction in body fat percentage. However, this practice is associated with serious risks to physical and mental health, the impact of which needs to be better understood. The objective of this research was to investigate and analyze the benefits and harms of the use of anabolic steroids by female bodybuilders, considering the effects on body composition and health. A systematic review was conducted following the PRISMA method, with searches in the SciELO, Scopus, and Google Scholar databases (2020-2025). Original articles and reviews addressing adult women practicing bodybuilding and the use of AAS were included. Analysis of the eight selected articles showed that EAAs promote significant and accelerated muscle mass gains and fat reduction. However, these aesthetic benefits are accompanied by serious adverse effects, including irreversible androgenic changes, cardiometabolic risks (increased LDL cholesterol and blood pressure), and negative impacts on mental health (anxiety, body dissatisfaction). It was also found that use is often motivated by aesthetic pressure and without adequate monitoring, aggravated by the lack of information among users and the lack of preparation of physical education professionals to provide guidance on the risks. It is concluded that the harm caused by the use of anabolic steroids by women outweighs any potential aesthetic benefits, thus requiring the implementation of public health strategies and professional training to provide guidance on the irreversible risks and promote the health of this population.}
}

